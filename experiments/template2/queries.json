    "wikidata": "SELECT DISTINCT ?capitalLabel WHERE { ?country wdt:P31 wd:Q3624078 ; wdt:P36 ?capital ; rdfs:label ?name. FILTER(?name IN ('France'@en, 'Bhutan'@en, 'Eritrea'@en)) SERVICE wikibase:label { bd:serviceParam wikibase:language 'en'. } }",
