from mugalois.core.types import Triple, TriplePattern, Environment

def seedsOf(term: str, env: Environment) -> set:
    """
    seedsOf(x, v) = v(x) if x is variable, otherwise {x}.

    Definition page 3 of the paper about triplet.

    Exemples :
      term = "?x",     env["?x"] = {"Mike", "Dustin"}  → {"Mike", "Dustin"}
      term = "?x",     env["?x"] = {}                  → set()  (pas de seeds)
      term = "st:Mike" (URI liée, pas variable)         → {"st:Mike"}
    """
    if term.startswith("?"):
        return env.get(term)
    else:
        return {term}


def updateEnv(env: Environment, 
              triples: set[Triple], 
              s: str, 
              o: str):
    """
    updateEnv(v, T, s, o) :
      - si s est une variable → v(s) ← projection sur la colonne s de T
      - si o est une variable → v(o) ← projection sur la colonne o de T

    définition page 3 de ton papier.
    Modifi

    Exemple :
      T = {(Mike, :isFriendWith, Eleven), (Dustin, :isFriendWith, Max)}
      s = "?x", o = "?y"
      → v("?x") devient {"Mike", "Dustin"}
      → v("?y") devient {"Eleven", "Max"}
    """
    if s.startswith("?"):
        # projection sur la colonne sujet
        values_s = {t.s for t in triples}
        env.update(s, values_s)

    if o.startswith("?"):
        # projection sur la colonne objet
        values_o = {t.o for t in triples}
        env.update(o, values_o)
